-- ระบุคนเปิดเพลง
local function getSoundOwnerName(inst)
	for _, player in ipairs(Players:GetPlayers()) do
		if (player.Character and inst:IsDescendantOf(player.Character)) or 
		   (player:FindFirstChild("Backpack") and inst:IsDescendantOf(player.Backpack)) then
			return player.DisplayName .. " (@" .. player.Name .. ")"
		end
	end
	return "คนในแมพ"
end

local function removeCardForSound(inst)
	local cardName = "Card_" .. tostring(inst:GetDebugId())
	local existingCard = scrollFrame:FindFirstChild(cardName)
	if existingCard then
		existingCard:Destroy()
	end
	
	local childCount = 0
	for _, v in ipairs(scrollFrame:GetChildren()) do
		if v:IsA("Frame") then childCount = childCount + 1 end
	end
	if childCount == 0 then
		emptyLabel.Visible = true
	end
end

local function updateOrCreateSoundCard(inst)
	local rawId = inst:IsA("Sound") and inst.SoundId or (inst:IsA("AudioPlayer") and inst.AssetId or "")
	local soundId = extractAssetId(rawId)

	-- ตรวจจับเฉพาะเพลง (ข้ามเสียงสั้นๆ เช่น เสียงปุ่ม/เสียงเดิน)
	if not soundId or soundId == "" or soundId == "0" or not inst.IsPlaying then
		removeCardForSound(inst)
		return
	end

	-- กรองเบื้องต้น: สคริปต์จะไม่ดักจับเสียงที่สั้นกว่า 3 วินาที (เพื่อให้ได้เฉพาะเพลง)
	if inst:IsA("Sound") and inst.TimeLength > 0 and inst.TimeLength < 3 then
		return
	end

	emptyLabel.Visible = false
	local cardKey = "Card_" .. tostring(inst:GetDebugId())
	local ownerName = getSoundOwnerName(inst)
	local existingCard = scrollFrame:FindFirstChild(cardKey)

	if existingCard then
		local infoLabel = existingCard:FindFirstChild("InfoLabel")
		local copyBtn = existingCard:FindFirstChild("CopyBtn")
		
		if infoLabel then
			infoLabel.Text = "🎵 กำลังอัปเดตข้อมูล...\nID: " .. soundId
		end

		if copyBtn then
			copyBtn:Destroy()
			local newCopyBtn = Instance.new("TextButton")
			newCopyBtn.Name = "CopyBtn"
			newCopyBtn.Size = UDim2.new(0, 62, 0, 26)
			newCopyBtn.Position = UDim2.new(1, -68, 0.5, -13)
			newCopyBtn.BackgroundColor3 = Color3.fromRGB(65, 85, 200)
			newCopyBtn.Font = Enum.Font.GothamBold
			newCopyBtn.Text = "คัดลอก"
			newCopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			newCopyBtn.TextSize = 10
			newCopyBtn.Parent = existingCard

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 5)
			btnCorner.Parent = newCopyBtn

			newCopyBtn.MouseButton1Click:Connect(function()
				copyID(soundId, newCopyBtn)
			end)
		end

		task.spawn(function()
			local title = "เพลง ID: " .. soundId
			if nameCache[soundId] then
				title = nameCache[soundId]
			else
				local success, info = pcall(function()
					return MarketplaceService:GetProductInfo(tonumber(soundId), Enum.InfoType.Asset)
				end)
				if success and info and info.Name then
					title = info.Name
					nameCache[soundId] = title
				elseif inst.Name and inst.Name ~= "" then
					title = inst.Name
				end
			end
			if infoLabel and existingCard.Parent then
				infoLabel.Text = "🎵 " .. title .. "\n👤 " .. ownerName .. "\n🆔 " .. soundId
			end
		end)
	else
		local card = Instance.new("Frame")
		card.Name = cardKey
		card.Size = UDim2.new(1, 0, 0, 56)
		card.BackgroundColor3 = Color3.fromRGB(28, 30, 44)
		card.BorderSizePixel = 0
		card.Parent = scrollFrame

		local cardCorner = Instance.new("UICorner")
		cardCorner.CornerRadius = UDim.new(0, 6)
		cardCorner.Parent = card

		local cardStroke = Instance.new("UIStroke")
		cardStroke.Color = rainbowEnabled and Color3.fromHSV(hue, 0.8, 1) or Color3.fromRGB(50, 60, 85)
		cardStroke.Thickness = 1.5
		cardStroke.Parent = card

		local infoLabel = Instance.new("TextLabel")
		infoLabel.Name = "InfoLabel"
		infoLabel.Size = UDim2.new(1, -78, 1, -6)
		infoLabel.Position = UDim2.new(0, 8, 0, 3)
		infoLabel.BackgroundTransparency = 1
		infoLabel.Font = Enum.Font.Gotham
		infoLabel.TextColor3 = Color3.fromRGB(230, 230, 240)
		infoLabel.TextSize = 10
		infoLabel.TextXAlignment = Enum.TextXAlignment.Left
		infoLabel.TextYAlignment = Enum.TextYAlignment.Center
		infoLabel.TextWrapped = true
		infoLabel.Text = "🎵 ดึงชื่อเพลง...\n👤 " .. ownerName .. "\n🆔 " .. soundId
		infoLabel.Parent = card

		local copyBtn = Instance.new("TextButton")
		copyBtn.Name = "CopyBtn"
		copyBtn.Size = UDim2.new(0, 62, 0, 26)
		copyBtn.Position = UDim2.new(1, -68, 0.5, -13)
		copyBtn.BackgroundColor3 = Color3.fromRGB(65, 85, 200)
		copyBtn.Font = Enum.Font.GothamBold
		copyBtn.Text = "คัดลอก"
		copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		copyBtn.TextSize = 10
		copyBtn.Parent = card

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 5)
		btnCorner.Parent = btnCorner

		copyBtn.MouseButton1Click:Connect(function()
			copyID(soundId, copyBtn)
		end)

		task.spawn(function()
			local title = "เพลง ID: " .. soundId
			if nameCache[soundId] then
				title = nameCache[soundId]
			else
				local success, info = pcall(function()
					return MarketplaceService:GetProductInfo(tonumber(soundId), Enum.InfoType.Asset)
				end)
				if success and info and info.Name then
					title = info.Name
					nameCache[soundId] = title
				elseif inst.Name and inst.Name ~= "" then
					title = inst.Name
				end
			end
			if infoLabel and card.Parent then
				infoLabel.Text = "🎵 " .. title .. "\n👤 " .. ownerName .. "\n🆔 " .. soundId
